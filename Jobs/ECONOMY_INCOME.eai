#IFDEF GLOBAL
  real economy_gold_income_remainder = 0
  real economy_lumber_income_remainder = 0
#ELSE

function EconomyGetMinesHarvested takes nothing returns integer
  local integer twm = TownWithMine()
  local integer i = twm
  local integer sum = 0
  local integer mine = racial_expansion
  local boolean b = race_manual_loading == true or race_uses_mine_expansion == true
  if race_manual_loading then
    set mine = race_manual_loading_mine
  endif
  if b or first_town_mine > 0 then
    set twm = TownCountDone(mine) - 1
  endif
  if twm < 0 then
    return 0
  endif
  if b then
    return twm + 1
  endif
  set i = twm
  loop
    exitwhen i > twm + 3
    if TownHasMine(i) and TownCountEx(mine,true,i) > 0 then
      set sum = sum + 1
    endif
    set i = i + 1
  endloop
  return sum
endfunction

function EconomyCountHarvesters takes nothing returns integer
  local group g = CreateGroup()
  local unit u = null
  local integer count = 0
  local integer id = 0
  call GroupEnumUnitsOfPlayer(g, ai_player, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    set id = GetUnitTypeId(u)
    if IsUnitAIControllable(u) and UnitAlive(u) and not IsUnitHidden(u) and not IsUnitLoaded(u) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and (GetUnitCurrentOrder(u) == OrderId("harvest") or GetUnitCurrentOrder(u) == OrderId("resumeharvesting")) and (id == old_id[racial_peon] or (race_manual_loading and id == old_id[race_manual_loading_wisp]) or (race_has_ghouls and id == old_id[racial_ghoul])) then
      set count = count + 1
    endif
    call GroupRemoveUnit(g, u)
  endloop
  call DestroyGroup(g)
  set g = null
  return count
endfunction

function EconomyIncomeJobEnabled takes nothing returns boolean
  return economy_income_interval > 0 and (economy_gold_income_percent != 100 or economy_lumber_income_percent != 100)
endfunction

function EconomyGetUpkeepFactor takes nothing returns real
  local integer i = 0
  local real upkeep = 1.0
  loop
    exitwhen i >= UPKEEP_NUM
    if FoodUsed() >= upkeep_border[i] then
      set upkeep = upkeep_goldchange[i]
    endif
    set i = i + 1
  endloop
  return upkeep
endfunction

function EconomyIncomeJob takes nothing returns nothing
  local real interval = 0.0
  local real gold_rate = 0.0
  local real lumber_rate = 0.0
  local real gold_delta = 0.0
  local real lumber_delta = 0.0
  local real upkeep = 1.0
  local integer gold_adjust = 0
  local integer lumber_adjust = 0
  local integer mines = 0
  local integer harvesters = 0
  local integer gold_workers = 0
  local integer lumber_workers = 0
  if not EconomyIncomeJobEnabled() then
    return
  endif
  set interval = I2R(Max(economy_income_interval, 1))
  set mines = EconomyGetMinesHarvested()
  set harvesters = EconomyCountHarvesters()
  set gold_workers = Min(harvesters, mines * ver_optimal_gold)
  set lumber_workers = Max(harvesters - gold_workers, 0)
  set upkeep = EconomyGetUpkeepFactor()
  // Approximate lumber at 2 wood/sec per active harvester to keep the modifier stable.
  set gold_rate = (I2R(gold_workers) * I2R(income_per_mine) * upkeep) / I2R(Max(ver_optimal_gold, 1))
  set lumber_rate = I2R(lumber_workers) * 2.0
  set gold_delta = gold_rate * interval * (I2R(economy_gold_income_percent) - 100.0) / 100.0 + economy_gold_income_remainder
  set lumber_delta = lumber_rate * interval * (I2R(economy_lumber_income_percent) - 100.0) / 100.0 + economy_lumber_income_remainder
  set gold_adjust = R2I(gold_delta)
  set lumber_adjust = R2I(lumber_delta)
  if gold_adjust < 0 and GetGold() + gold_adjust < 0 then
    set gold_adjust = -GetGold()
    set economy_gold_income_remainder = 0
  else
    set economy_gold_income_remainder = gold_delta - I2R(gold_adjust)
  endif
  if lumber_adjust < 0 and GetWood() + lumber_adjust < 0 then
    set lumber_adjust = -GetWood()
    set economy_lumber_income_remainder = 0
  else
    set economy_lumber_income_remainder = lumber_delta - I2R(lumber_adjust)
  endif
  if gold_adjust != 0 then
    call SetPlayerState(ai_player, PLAYER_STATE_RESOURCE_GOLD, GetGold() + gold_adjust)
  endif
  if lumber_adjust != 0 then
    call SetPlayerState(ai_player, PLAYER_STATE_RESOURCE_LUMBER, GetWood() + lumber_adjust)
  endif
  call TQAddJob(I2R(Max(economy_income_interval, 1)), ECONOMY_INCOME, 0)
endfunction
#ENDIF
